# Copy to .env for running the server without Docker (npm run dev).
PORT=5000
MONGODB_URI=mongodb://localhost:27017/portfolio
# Password for the /admin page — pick something long.
ADMIN_PASSWORD=change-me
# Any long random string; used to sign admin login tokens.
JWT_SECRET=replace-with-a-long-random-string
# Comma-separated list of sites allowed to call the API (your Vercel URL in production).
CLIENT_ORIGIN=http://localhost:5173
